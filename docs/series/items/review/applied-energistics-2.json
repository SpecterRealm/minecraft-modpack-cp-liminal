   "kind": "item"
  },
  {
   "match": "^(wireless_terminal|wireless_crafting_terminal|crafting_terminal|pattern_access_terminal|pattern_encoding_terminal|terminal|portable_.*)$",
   "clear": [
    "kind",
    "function",
    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "kind:gadget",
    "function:automate",
    "needs:none"
   ],
   "kind": "item"
  },
  {
   "match": "^(certus_quartz|nether_quartz|fluix)_(axe|hoe|pickaxe|shovel)$",
