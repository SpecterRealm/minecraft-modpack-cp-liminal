{
 "note": "AE2 pillar: ME network (controller, cables, drives, interfaces, crafting CPUs, pattern providers), autocrafting, storage cells by capacity tier (1k to 256k), P2P tunnels, wireless terminals, spatial storage, and a few generators (crank, vibration chamber, crystal resonance generator). AE power is converted to FE. Quartz and sky stone are world-gen items; in Verdant the meteorite/sky-stone source needs checking. Built-in support: supported by 41 mods (most AE2 add-ons); supports Mekanism via data (AppMek add-on).",
 "rules": [
  {
   "match": "^(debug_|.*\\.ae2|tiny_tnt_primed$|missing_content$|wrapped_generic_stack$|mysterious_cube|not_so_mysterious_cube)|^debug|_debug_",
   "ui": true
  },
  {
   "match": "^(crystal_resonance_generator|vibration_chamber|crank)$",
   "clear": [
    "kind",
    "function",
    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "kind:machine",
    "function:generate",
    "power-role:makes",
    "power-type:fe",
    "needs:none"
   ]
  },
  {
   "match": "^(creative_energy_cell)$",
   "clear": [
    "kind",
    "function",
    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "kind:block",
    "function:generate",
    "power-role:makes",
    "power-type:fe",
    "role:dev-only"
   ]
  },
  {
   "match": "^(energy_cell|dense_energy_cell|energy_acceptor|cable_energy_acceptor)$",
   "clear": [
    "kind",
    "function",
    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "kind:block",
    "function:store",
    "power-role:stores",
    "power-type:fe",
    "needs:none"
   ]
  },
  {
   "match": "^(controller)$",
   "clear": [
    "kind",
    "function",
    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "kind:multiblock",
    "function:automate",
    "power-role:uses",
    "power-type:fe",
    "needs:none"
   ]
  },
  {
   "match": "^(.*_(covered|glass|smart)(_dense)?_cable|.*_covered_dense_cable|cable_bus|cable_anchor|cable_interface|cable_pattern_provider|fluix_.*cable|quantum_link|quantum_ring)$",
   "clear": [
    "kind",
    "function",
    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "kind:block",
    "function:transfer",
    "power-role:transfers",
    "power-type:fe",
    "needs:none"
   ]
  },
  {
   "match": "^(drive|chest|io_port|cell_workbench|.*_crafting_storage|crafting_storage|crafting_unit|crafting_accelerator|crafting_monitor|interface|pattern_provider|molecular_assembler|inscriber|charger|condenser|growth_accelerator|spatial_io_port|spatial_anchor|spatial_pylon|wireless_access_point|annihilation_plane|formation_plane|storage_bus|import_bus|export_bus|toggle_bus|inverted_toggle_bus|terminal|crafting_terminal|pattern_access_terminal|pattern_encoding_terminal|monitor|storage_monitor|conversion_monitor|dark_monitor|light_detector)$",
   "clear": [
    "kind",
    "function",
    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "kind:machine",
    "function:automate",
    "power-role:uses",
    "power-type:fe",
    "needs:none"
   ]
  },
  {
   "match": "^(drive|chest|io_port|.*_crafting_storage|crafting_storage|sky_stone_chest|smooth_sky_stone_chest|sky_stone_tank)$",
   "clear": [
