    "kind",
    "function",
    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "kind:tool",
    "needs:none"
   ]
  },
  {
   "match": "^(certus_quartz|nether_quartz|fluix)_sword$",
   "clear": [
