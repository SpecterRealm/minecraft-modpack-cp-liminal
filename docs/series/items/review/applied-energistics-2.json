    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "kind:weapon",
    "function:defend",
    "needs:none"
   ]
  },
  {
   "match": "^(certus_quartz_wrench|nether_quartz_wrench|certus_quartz_cutting_knife|nether_quartz_cutting_knife|network_tool|entropy_manipulator|charged_staff|matter_cannon|fluix_upgrade_smithing_template)$",
   "clear": [
    "kind",
