  {
   "match": "^(certus_quartz_crystal|charged_certus_quartz_crystal|certus_quartz_dust|fluix_crystal|fluix_dust|fluix_pearl|ender_dust|sky_dust|silicon|printed_.*|.*_processor|.*_processor_press|silicon_press|matter_ball|singularity|quantum_entangled_singularity|quartz_fiber|annihilation_core|formation_core|blank_pattern|.*_paint_ball|.*_lumen_paint_ball|paint)$",
   "clear": [
    "kind",
    "function",
    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "kind:material",
    "needs:none"
   ],
   "kind": "item"
  },
  {
   "match": "^(.*_paint_ball|.*_lumen_paint_ball|paint)$",
   "clear": [
