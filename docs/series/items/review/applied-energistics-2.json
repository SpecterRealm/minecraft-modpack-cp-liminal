    "needs:none"
   ]
  },
  {
   "match": "_bud$|^(small|medium|large)_quartz_bud$|budding_quartz$|quartz_cluster$",
   "clear": [
    "kind",
    "function",
    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "kind:block",
    "function:farm",
    "needs:none"
   ],
   "kind": "block"
  },
  {
   "match": "^(cut_|chiseled_|smooth_|sky_stone|quartz_|fluix_).*(slab|stairs|wall|block|brick|bricks|pillar|glass|fixture)$|^(quartz_block|quartz_bricks|sky_stone_block|matrix_frame|fluix_block)$",
   "clear": [
    "kind",
    "function",
    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "kind:decoration",
    "needs:none"
   ],
   "kind": "block"
  },
  {
   "match": "^tiny_tnt$",
   "clear": [
    "kind",
    "function",
    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "kind:consumable",
    "function:mine",
    "needs:none"
   ]
  },
  {
   "match": "^sky_stone|sky_dust|meteorite",
   "clear": [
