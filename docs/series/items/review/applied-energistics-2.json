    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "needs:none"
   ]
  },
  {
   "match": "^villager\\.",
   "ui": true
  },
  {
   "match": "^crystal_resonance_generator$",
   "set": [
    "fuel:none"
   ]
  },
  {
   "match": "^vibration_chamber$",
   "set": [
    "fuel:solid"
   ]
  },
  {
   "match": "^crank$",
   "set": [
    "fuel:kinetic"
   ]
  },
  {
   "match": ".",
   "default": [
    "power-role:none",
    "power-type:none",
    "needs:none"
   ]
  }
 ]
}