   ],
   "kind": "entity"
  },
  {
   "match": "^(djinni|foliot|afrit|marid)(_unbound)?$",
   "clear": [
    "kind",
    "function",
    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "kind:mob",
    "function:automate",
    "needs:spell-tech"
   ],
   "kind": "entity"
  },
  {
   "match": ".",
   "kind": "entity",
   "clear": [
    "kind"
   ],
   "set": [
    "kind:mob"
   ]
  },
  {
   "match": ".",
   "default": [
    "power-role:none",
    "power-type:none",
    "needs:spell-tech"
   ]
  }
 ]
