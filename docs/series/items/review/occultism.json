   "clear": [
    "kind",
    "function",
    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "kind:material",
    "needs:spell-tech"
   ],
   "kind": "item"
  },
  {
   "match": "^(iesnium_pickaxe|infused_pickaxe|butcher_knife|iesnium_butcher_knife|brush)$",
   "clear": [
    "kind",
    "function",
    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "kind:tool",
    "needs:spell-tech"
   ],
   "kind": "item"
  },
  {
   "match": "^(ender_satchel|ritual_satchel.*|satchel|familiar_ring|flame_of_automation|fragile_soul_gem|fragile_soul_gem_empty|soul_gem|knowledge_tablet|magic_lamp_.*|otherworld_goggles|pentacle_.*|vitality_compass|true_sight_staff|storage_remote|divination_rod|.*_ring)$",
   "clear": [
    "kind",
    "function",
    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "kind:gadget",
    "needs:spell-tech"
   ],
   "kind": "item"
  },
  {
   "match": "^(afrit|afrit_wild|djinni|marid|marid_unbound|foliot|demonic_husband|demonic_wife|iesnium_golem|shub_niggurath_spawn|mercy_goat|wondering_trader|otherworld_bird|thrown_sword)$",
   "clear": [
    "kind",
    "function",
    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "kind:mob",
    "needs:spell-tech"
   ],
   "kind": "entity"
  },
  {
   "match": "^(.*_familiar|possessed_.*|wild_.*)$",
   "clear": [
