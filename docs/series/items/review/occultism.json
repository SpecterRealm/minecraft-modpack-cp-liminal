{
 "note": "Spirit-magic pillar: rituals with chalk and sacrificial bowls summon familiars and spirits (foliot, djinni, afrit, marid), which do work. Miner spirits run the dimensional mineshaft and return ores from the mining dimension (yields/occultism.json); Iesnium and silver ores come that way. Dimensional storage (storage controller and stabilizers) is bulk storage. Mobs and most rituals are spell-tech. Built-in support: supported by 9 mods (Apotheosis, Botany Pots/Trees, Create, Productive Bees, ProjectE Integration, Theurgy, Ars Ocultas and Occultism KubeJS). No FE power. Note: the miner recipe conditions depend on ore tags being non-empty.",
 "rules": [
  {
   "match": "\\.|_icon$|^debug|^ritual_dummy",
   "ui": true
  },
  {
   "match": "^(dimensional_extractor|dimensional_mineshaft|dimensional_battlefield|entity_wormhole(_dark)?|stable_wormhole(_dark)?|spirit_grindstone|iesnium_anvil|otherstone_pedestal(_silver)?|dimensional_matrix)$",
   "clear": [
    "kind",
    "function",
    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "kind:machine",
    "function:craft",
    "function:process",
    "power-role:none",
    "power-type:none",
    "needs:spell-tech"
   ],
   "kind": "block"
  },
  {
   "match": "^(dimensional_mineshaft)$",
   "clear": [
    "kind",
    "function",
    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "kind:machine",
    "function:mine",
    "power-role:none",
    "power-type:none",
    "needs:spell-tech",
    "role:core"
   ],
   "kind": "block"
  },
  {
   "match": "^(storage_controller.*|storage_stabilizer_tier\\d.*|storage_controller_base.*)$",
   "clear": [
    "kind",
    "function",
    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "kind:block",
    "function:store",
    "scale:tiered",
    "power-role:none",
    "power-type:none",
    "needs:spell-tech"
   ],
   "kind": "block"
  },
  {
   "match": "^(.*sacrificial_bowl|celestial_chalice|eldritch_chalice)$",
   "clear": [
    "kind",
    "function",
    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "kind:block",
    "function:craft",
    "function:enchant",
    "needs:spell-tech"
   ],
   "kind": "block"
  },
  {
   "match": "^(chalk_glyph_.*|chalk_.*|.*_paste)$",
   "clear": [
    "kind",
    "function",
    "needs"
   ],
   "set": [
    "kind:ingredient",
    "function:craft",
    "needs:spell-tech"
   ]
  },
  {
   "match": "^(.*iesnium_ore|silver_ore|silver_ore_deepslate|raw_iesnium_block|raw_silver_block|iesnium_block|silver_block)$",
   "clear": [
    "kind",
    "function",
    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "kind:block",
    "needs:ore"
   ],
   "kind": "block"
  },
  {
   "match": "^(raw_iesnium|raw_silver)$",
   "clear": [
    "kind",
    "function",
    "power-role",
    "power-type",
    "needs"
   ],
   "set": [
    "kind:material",
    "needs:ore"
   ],
   "kind": "item"
  },
  {
   "match": "^(other.*|.*otherstone.*|.*otherrock.*|.*_otherrock_bricks|chiseled_other.*|cracked_other.*|large_candle.*|lighted_air|spirit_(fire|torch|lantern|campfire)|tallow_block|skeleton_skull_dummy|wither_skeleton_skull_dummy|datura|stripped_otherworld.*)$",
   "clear": [
    "kind",
    "function",
    "needs"
   ],
   "set": [
    "kind:decoration",
    "needs:spell-tech"
   ],
   "kind": "block"
  },
  {
