{
 "class": "ae2-addon",
 "purpose": "Request items into an AE2 network",
 "note": "Requester terminal and requester block. Niche AE2 convenience.",
 "rules": [
  {
   "match": "\\.",
   "ui": true
  },
  {
   "match": "^.*$",
   "clear": [
    "kind",
    "function",
    "power-role",
    "power-type"
   ],
   "set": [
    "kind:machine",
    "function:automate",
    "power-role:uses",
    "power-type:fe"
   ]
  },
  {
   "match": ".",
   "default": [
    "power-role:none",
    "power-type:none",
    "needs:none"
   ]
  }
 ]
}