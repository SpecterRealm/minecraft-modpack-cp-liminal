 "tuning": [
  {
   "lever": "config",
   "where": "config/powah.json5 -> general.energy_per_fuel_tick",
   "default": 30,
   "effect": "FE produced per fuel tick in every Furnator; 1 coal (1600 ticks) = 48,000 FE at default"
  },
  {
   "lever": "config",
   "where": "config/powah.json5 -> general.energizing_energy_ratio",
   "default": 1.0,
   "effect": "Multiplier on the FE cost of every energizing recipe (0.001 to 1000)"
  },
  {
   "lever": "config",
   "where": "config/powah.json5 -> generators.<type>.{capacities,transfer_rates,generation_rates}.<tier>",
   "default": "see per-item stats",
   "effect": "Per-tier capacity, transfer and generation for furnators, magmators, reactors, solar_panels, thermo_generators"
  },
  {
   "lever": "config",
   "where": "config/powah.json5 -> devices.<type>",
   "default": "see per-item stats",
   "effect": "Per-tier capacity/transfer for energy_cells, batteries, dischargers, cables, ender_cells, ender_gates, energizing_rods, hoppers, player_transmitters"
  },
  {
   "lever": "config",
   "where": "config/powah.json5 -> general.{player_aerial_pearl,dimensional_binding_card,lens_of_ender}",
   "default": true,
   "effect": "Toggle the right-click-a-mob ways of getting these three items"
  },
  {
   "lever": "datamap",
   "where": "data/powah/data_maps/fluid/magmator_fuel.json",
   "default": {
    "#c:lava": {
     "energy_produced": 10000
    }
   },
   "effect": "Which fluids the Magmator burns and their energy value; add or change entries in a datapack or KubeJS"
  },
  {
   "lever": "datamap",
   "where": "data/powah/data_maps/fluid/heat_source.json, block/heat_source.json",
   "default": {
    "#c:lava": 1000,
    "minecraft:magma_block": 800,
    "powah:blazing_crystal_block": 2800
   },
   "effect": "Heat sources for the Thermo Generator (temperature)"
  },
  {
   "lever": "datamap",
   "where": "data/powah/data_maps/fluid/fluid_coolant.json, item/solid_coolant.json",
   "default": {
    "#c:water": 0,
    "minecraft:ice": -5,
    "minecraft:blue_ice": -17,
    "powah:dry_ice": -32
   },
   "effect": "Coolants for the Thermo Generator and Reactor"
  },
  {
   "lever": "recipe",
   "where": "data/powah/recipe/crafting/*.json and recipe/energizing/*.json",
   "effect": "All tier recipes; edit or replace through KubeJS recipe events"
  }
 ],
