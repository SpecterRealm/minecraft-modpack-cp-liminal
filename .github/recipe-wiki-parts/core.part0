#!/usr/bin/env python3
"""
CP Liminal — Recipe Wiki Builder

Offline dump of crafting recipes from local Prism mod JARs + KubeJS scripts.
Produces (generated; do not commit large dumps unless intentional):
  docs/recipe_data.json  — machine-readable index (item_id → recipes)
  docs/recipe_wiki.html  — self-contained browseable HTML recipe tree

Usage:
  # Default: Prism CP-Liminal-Dev instance mods folder (macOS path)
  python3 scripts/build_recipe_wiki.py

  # Or point at any mods directory with JARs already installed:
  RECIPE_WIKI_MODS_DIR=/path/to/minecraft/mods python3 scripts/build_recipe_wiki.py

  make recipe-wiki

Do NOT reuse Verdant's docs/recipe_data.json for Liminal analysis (different
mod list, pins, and KubeJS). Generate a Liminal dump from CP-Liminal-Dev JARs.
"""

import base64
import json
import os
import re
import sys
import zipfile
from datetime import datetime, timezone
from pathlib import Path

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

REPO_ROOT  = Path(__file__).parent.parent
# Instance name follows the repo folder: minecraft-modpack-cp-<pack> -> CP-<Pack>-Dev
_PACK = REPO_ROOT.name.rsplit("cp-", 1)[-1].capitalize()
_DEFAULT_MODS = (
    Path.home()
    / "Library/Application Support/PrismLauncher"
    / f"instances/CP-{_PACK}-Dev/minecraft/mods"
)
MODS_DIR   = Path(os.environ.get("RECIPE_WIKI_MODS_DIR", _DEFAULT_MODS))
KUBEJS_DIR = REPO_ROOT / "kubejs" / "server_scripts"
OUT_JSON   = REPO_ROOT / "docs" / "recipe_data.json"
OUT_HTML   = REPO_ROOT / "docs" / "recipe_wiki.html"

# ---------------------------------------------------------------------------
# Recipe type filter — skip loot tables, advancements, tags, etc.
# ---------------------------------------------------------------------------

VANILLA_TYPES = {
    "minecraft:crafting_shaped",
    "minecraft:crafting_shapeless",
    "minecraft:smelting",
    "minecraft:blasting",
    "minecraft:smoking",
    "minecraft:stonecutting",
    "minecraft:campfire_cooking",
    "minecraft:smithing_transform",
    "minecraft:smithing_trim",
}

# Recipe *type* namespaces to keep (not item IDs). Expand when a pillar's
# machine recipes matter for offline audits (MA ↔ AgriCraft, bees, PE, …).
MOD_PREFIXES = [
    "create:", "mekanism:", "ae2:", "exdeorum:", "silentgear:",
    "farmersdelight:", "sophisticatedstorage:", "sophisticatedbackpacks:",
    "exmachinis:", "cobblegengalore:",
    "mysticalagriculture:", "mysticalcustomization:", "mysticalautomation:",
    "agricraft:", "productivebees:", "productivefarming:", "productivetrees:",
    "productivemetalworks:", "botanypots:",
    "ars_nouveau:", "occultism:", "projecte:", "powah:",
    "bigreactors:", "draconicevolution:", "apotheosis:",
    "theurgy:", "replication:", "hostileneuralnetworks:",
]


def keep_type(rtype: str) -> bool:
    """Keep every recipe type: an allowlist silently hides whole mods. Recipes without a usable result are
    counted in SKIPPED (written to the dump) so what is left out stays visible."""
    return bool(rtype)


SKIPPED: dict[str, int] = {}
UNPARSED: dict[str, list] = {}   # raw JSON of recipes with no readable output, per type (capped)
UNPARSED_CAP = 400


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

_FLUID_LIKE = ("fluid", "chemical", "gas", "infuse_type", "slurry", "pigment")


def _stack_id(val) -> str | None:
    """Item id of a result stack, or a pseudo id for fluids and chemicals (fluid:<id>, chemical:<id>, ...)."""
    if isinstance(val, str):
        return val
    if not isinstance(val, dict):
        return None
    for key in _FLUID_LIKE:
        ref = val.get(key)
        if isinstance(ref, dict):
            ref = ref.get("id") or ref.get("fluid") or ref.get("chemical")
        if isinstance(ref, str):
            return f"{key}:{ref}"
    ref = val.get("id") or val.get("item")
    if isinstance(ref, dict):
        ref = ref.get("id") or ref.get("item")
    if isinstance(ref, str):
        # FluidStack codec: {"id", "amount"} without "count"
        if "amount" in val and "count" not in val and "item" not in val:
            return f"fluid:{ref}"
        return ref
    for key in ("ingredient", "stack"):  # nested stack wrappers
        if key in val:
            return _stack_id(val[key])
    return None


def get_result_ids(data: dict) -> list[str]:
    """Every output of a recipe (items, fluids, chemicals), in order, without repeats."""
    found: list[str] = []
    for key in ("result", "results", "output", "outputs", "fluid_output", "fluid_result", "byproducts"):
        val = data.get(key)
        if not val:
            continue
        for v in (val if isinstance(val, list) else [val]):
            rid = _stack_id(v)
            if rid and rid not in found:
                found.append(rid)
    return found


def get_result_id(data: dict) -> str | None:
    """Pull the primary output ID from any recipe dict."""
    ids = get_result_ids(data)
    return ids[0] if ids else None


def get_result_count(data: dict) -> int:
    for key in ("result", "results", "output"):
        val = data.get(key)
        if not val:
            continue
        if isinstance(val, list):
            val = val[0] if val else None
        if isinstance(val, dict):
            return int(val.get("count", 1))
    return 1


def norm_ing(raw, _depth: int = 0) -> dict:
    """Normalise any ingredient shape to {type, value, count}."""
    if _depth > 4:
        return {"type": "item", "value": "", "count": 1}
    if isinstance(raw, list):
        for r in raw:
            if r:
                raw = r
                break
        else:
            return {"type": "item", "value": "", "count": 1}
    if isinstance(raw, str):
        return {"type": "item", "value": raw, "count": 1}
    if not isinstance(raw, dict):
        return {"type": "item", "value": "", "count": 1}
    count = int(raw.get("count", 1))
    if "tag" in raw:
        return {"type": "tag", "value": raw["tag"], "count": count}
    val = raw.get("id") or raw.get("item")
    if val:
        return {"type": "item", "value": str(val), "count": count}
    nested = raw.get("ingredient")
    if nested and isinstance(nested, (dict, list)):
        return norm_ing(nested, _depth + 1)
    return {"type": "item", "value": "", "count": count}


def ingredients_from(data: dict) -> list[dict]:
    """Return flat ingredient list from any recipe type."""
    rtype = data.get("type", "")
    out = []

    if "crafting_shaped" in rtype:
        pattern = data.get("pattern", [])
        key     = data.get("key", {})
        seen: set[str] = set()
        for row in pattern:
            for ch in row:
                if ch != " " and ch in key and ch not in seen:
                    seen.add(ch)
                    out.append(norm_ing(key[ch]))
    elif "crafting_shapeless" in rtype:
        for ing in data.get("ingredients", []):
            out.append(norm_ing(ing))
    elif rtype in (
        "minecraft:smelting", "minecraft:blasting", "minecraft:smoking",
        "minecraft:campfire_cooking", "minecraft:stonecutting",
    ):
        ing = data.get("ingredient", {})
        out.append(norm_ing(ing))
    else:
        # Generic — try common field names
        for field in ("ingredients", "ingredient", "inputs", "input"):
            val = data.get(field)
            if not val:
                continue
            if isinstance(val, list):
                for v in val:
                    out.append(norm_ing(v))
            else:
                out.append(norm_ing(val))
            break

    # Fields that name a required item outside the ingredient lists (Ex Deorum sieve mesh)
    mesh = data.get("mesh")
    if mesh:
        out.append(norm_ing(mesh))
    out = [i for i in out if i.get("value")]
    if not out:
        # Unusual recipe shapes (Theurgy sources and salts, Ars pedestals and reagents, Create sequences...):
        # take every item or tag reference outside the result keys.
        out = [i for i in _scan_refs(data) if i.get("value")]
    return out


_RESULT_KEYS = {"result", "results", "output", "outputs", "fluid_output", "fluid_result", "byproducts"}


def _scan_refs(node, _top: bool = True, _depth: int = 0) -> list[dict]:
    """Collect {item}/{tag}/{id} references anywhere in a recipe, skipping result keys."""
    found: list[dict] = []
    if _depth > 8:
        return found
    if isinstance(node, dict):
        if not _top:  # references sit below the recipe root; the root's own keys are structure, not ingredients
            if "tag" in node and isinstance(node["tag"], str):
                found.append({"type": "tag", "value": node["tag"], "count": int(node.get("count", 1) or 1)})
                return found
            if isinstance(node.get("item"), str):
                found.append({"type": "item", "value": node["item"], "count": int(node.get("count", 1) or 1)})
                return found
            for key in _FLUID_LIKE:  # fluids and chemicals are pseudo items: fluid:<id>, chemical:<id>
                ref = node.get(key)
                if isinstance(ref, dict):
                    ref = ref.get("id") or ref.get(key)
                if isinstance(ref, str):
                    found.append({"type": "item", "value": f"{key}:{ref}", "count": 1})
                    return found
            # Block states ({"Name": ...}, Cobblegen Galore) and item stacks ({"id": ...}); water and lava are world sources
            for key in ("Name", "id"):
                val = node.get(key)
                if isinstance(val, str) and ":" in val:
                    if val not in ("minecraft:water", "minecraft:lava"):
                        found.append({"type": "item", "value": val, "count": int(node.get("count", 1) or 1)})
                    return found
        for key, val in node.items():
            if _top and key in _RESULT_KEYS:
                continue
            found.extend(_scan_refs(val, False, _depth + 1))
    elif isinstance(node, list):
        for val in node:
            found.extend(_scan_refs(val, False, _depth + 1))
    return found


_MODID_RE = re.compile(r'^\s*modId\s*=\s*"([^"]+)"')


def installed_mod_ids() -> set[str]:
    """Mod ids from the [[mods]] tables of the installed jars, plus the built-in namespaces."""
    ids = {"minecraft", "neoforge", "c"}
    for jar in sorted(MODS_DIR.glob("*.jar")):
        try:
            with zipfile.ZipFile(jar) as zf:
                for name in ("META-INF/neoforge.mods.toml", "META-INF/mods.toml"):
                    if name not in zf.namelist():
                        continue
                    table = ""
                    for line in zf.read(name).decode("utf-8", "replace").splitlines():
                        st = line.strip()
                        if st.startswith("["):
                            table = st
                        elif table == "[[mods]]":
                            m = _MODID_RE.match(line)
                            if m:
                                ids.add(m.group(1))
        except (zipfile.BadZipFile, OSError):
            continue
    return ids


def eval_conditions(conds, ctx) -> bool:
    """NeoForge load conditions. Unknown condition types count as met, so no real recipe is dropped."""
    if not conds:
        return True
    if isinstance(conds, dict):
        conds = [conds]
    for c in conds:
        t = c.get("type", "")
        if t == "neoforge:mod_loaded":
            ok = c.get("modid") in ctx["mods"]
        elif t == "neoforge:not":
            ok = not eval_conditions(c.get("value"), ctx)
        elif t == "neoforge:and":
            ok = all(eval_conditions(v, ctx) for v in c.get("values", []))
        elif t == "neoforge:or":
            ok = any(eval_conditions(v, ctx) for v in c.get("values", []))
        elif t == "neoforge:false":
            ok = False
        elif t == "neoforge:tag_empty":
            ok = not ctx["tags"].get(c.get("tag"))
        elif t == "neoforge:item_exists":
            ref = c.get("item", "")
            ok = ref.split(":", 1)[0] in ctx["mods"]
        else:
            ok = True
        if not ok:
            return False
    return True


def shaped_grid(data: dict) -> list[list[dict | None]]:
    """Return 3×3 grid of ingredient dicts (or None for empty cells)."""
    pattern = data.get("pattern", [])
    key     = data.get("key", {})
    # Pad to 3 rows of 3
    grid: list[list[dict | None]] = []
    for row_str in pattern[:3]:
        row: list[dict | None] = []
        for ch in (row_str + "   ")[:3]:
            if ch == " " or ch not in key:
                row.append(None)
            else:
                row.append(norm_ing(key[ch]))
        grid.append(row)
    while len(grid) < 3:
        grid.append([None, None, None])
    return grid


# ---------------------------------------------------------------------------
# 1. Extract recipes from JARs
# ---------------------------------------------------------------------------

def vanilla_jars() -> list[Path]:
    """The Minecraft client jar (vanilla recipes and tags), from Prism's libraries folder or RECIPE_WIKI_VANILLA_JAR."""
    override = os.environ.get("RECIPE_WIKI_VANILLA_JAR")
    if override:
        return [Path(override)] if Path(override).is_file() else []
    try:
        data_dir = MODS_DIR.parents[3]  # <prism data>/instances/<instance>/minecraft/mods
    except IndexError:
        return []
    libs = data_dir / "libraries"
    found = sorted((libs / "com" / "mojang" / "minecraft").glob("*/minecraft-*-client.jar"))[-1:]
    # NeoForge's own jar holds the common (c:) tags that recipes use
    found += sorted((libs / "net" / "neoforged" / "neoforge").glob("*/neoforge-*-universal.jar"))[-1:]
    return found


def extract_jar_recipes() -> dict[str, list[dict]]:
    """Returns item_id → list of recipe entries from all mod JARs."""
    recipes: dict[str, list[dict]] = {}
    if not MODS_DIR.is_dir():
        print(
            f"✗ Mods directory not found: {MODS_DIR}\n"
            "  Launch the pack's CP-<Pack>-Dev instance once so packwiz installs JARs, or set\n"
            "  RECIPE_WIKI_MODS_DIR to a folder that already contains *.jar.",
            file=sys.stderr,
        )
        sys.exit(1)
    jars = sorted(MODS_DIR.glob("*.jar"))
    if not jars:
        print(
            f"✗ No *.jar under {MODS_DIR}\n"
            "  This script needs installed mod JARs (Prism instance after packwiz pull).",
            file=sys.stderr,
        )
        sys.exit(1)
    vanilla = vanilla_jars()
    extra = ", ".join(v.name for v in vanilla)
    print(f"Scanning {len(jars)} JARs in {MODS_DIR}" + (f" plus {extra}" if vanilla else " (vanilla jar not found: no vanilla recipes)") + "...")
    jars = jars + vanilla

    for jar_path in jars:
        try:
            with zipfile.ZipFile(jar_path) as zf:
                recipe_files = [
                    n for n in zf.namelist()
                    if "/recipe/" in n and n.endswith(".json")
