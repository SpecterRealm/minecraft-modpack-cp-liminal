# macOS
.DS_Store
**/.DS_Store

# Mod jars — never commit (pins live in mods/*.pw.toml)
*.jar

# Pack build / local serve
dist/
.serve.pid
.serve.log
node_modules/
package-lock.json
.packwiz-cache/

# Editor and mod config backups
*.bak
**/*.bak

# Local scratch
.tmp/
.tmp-javap/
scripts/__pycache__/
.venv/
.venv-patchouli/

# Offline recipe wiki HTML embeds textures and is often huge — open locally after make recipe-wiki.
# Track docs/recipe_data.json and docs/recipe-analyze/ so agents can audit without Prism.
# Regenerate after mod list / KubeJS changes: make recipe-audit (do not copy Verdant dumps).
docs/recipe_wiki.html

# Assembled on first make recipe-wiki from .github/recipe-wiki-parts/
scripts/recipe_wiki_core.py
scripts/analyze_recipe_wiki.py

# Minecraft runtime (if someone opens the repo as instance)
logs/
crash-reports/
saves/
screenshots/
world/

# Export outputs (keep zips out of git)
*.zip
*.mrpack
